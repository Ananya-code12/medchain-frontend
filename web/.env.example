# true = built-in fake data (no backend). false = real backend.
VITE_USE_MOCK=false
# Backend base URL: no trailing "/", no "/api/v1". Local: http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
# Vite reads these at BUILD time: after changing them on Vercel/Render, redeploy (clear build cache).
